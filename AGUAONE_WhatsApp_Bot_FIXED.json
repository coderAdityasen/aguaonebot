    {
      "parameters": {
        "jsCode": "const data = $('Conversation Router').first().json;\n\nif (data.replyType === 'none' || !data.reply) {\n  return [];\n}\n\nlet payload;\n\nif (data.replyType === 'list') {\n  payload = {\n    messaging_product: 'whatsapp',\n    recipient_type: 'individual', // <--- ADDED THIS\n    to: data.phone,\n    type: 'interactive',\n    interactive: {\n      type: 'list',\n      body: { text: data.reply },\n      action: {\n        button: 'विकल्प चुनें',\n        sections: [\n          {\n            title: 'Options',\n            rows: data.options.map(option => ({\n              id: option.id,\n              title: option.title,\n              ...(option.description ? { description: option.description } : {})\n            }))\n          }\n        ]\n      }\n    }\n  };\n} else {\n  payload = {\n    messaging_product: 'whatsapp',\n    recipient_type: 'individual', // <--- ADDED THIS\n    to: data.phone,\n    type: 'text',\n    text: { body: data.reply }\n  };\n}\n\nreturn {\n  json: {\n    phone: data.phone,\n    phoneNumberId: data.phoneNumberId,\n    replyType: data.replyType,\n    reply: data.reply,\n    payload\n  }\n};"
