      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nif (!input.messages || !input.messages[0]) {\n  return [];\n}\n\nconst m = input.messages[0];\nconst c = input.contacts?.[0] || {};\n\nlet message = '';\nlet selectedOption = '';\nlet selectedTitle = '';\n\nif (m.type === 'text') {\n  message = m.text?.body?.trim() || '';\n}\n\nif (m.type === 'interactive') {\n  if (m.interactive?.type === 'list_reply') {\n    selectedOption = m.interactive.list_reply?.id || '';\n    selectedTitle = m.interactive.list_reply?.title || '';\n    message = selectedOption;\n  }\n\n  if (m.interactive?.type === 'button_reply') {\n    selectedOption = m.interactive.button_reply?.id || '';\n    selectedTitle = m.interactive.button_reply?.title || '';\n    message = selectedOption;\n  }\n}\n\nreturn {\n  json: {\n    phone: m.from || '',\n    name: c.profile?.name || 'Customer',\n    message,\n    selectedOption,\n    selectedTitle,\n    messageType: m.type || 'text',\n    messageId: m.id || '',\n    timestamp: m.timestamp || '',\n    receivedAt: new Date().toISOString(),\n    phoneNumberId: input.metadata?.phone_number_id || ''\n  }\n};"
      },
