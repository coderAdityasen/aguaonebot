      "parameters": {
        "jsCode": "// AGUAONE WhatsApp Lead Qualification Bot\n// Deterministic state machine. lead_status is the session lifecycle:\n// IN_PROGRESS -> HANDOFF (terminal; human takes over).\nconst incoming = $('Parse Incoming Message').first().json;\nconst session = $json || {};\n\nconst phone = incoming.phone || session.phone || '';\nconst name = incoming.name || session.name || 'Customer';\n\nconst selectedOption = (incoming.selectedOption || '').trim();\nconst rawText = (incoming.message || '').trim();\nconst selectedTitle = (incoming.selectedTitle || '').trim();\nconst lower = rawText.toLowerCase();\n\nconst QUESTIONS = {\n  city: {\n    text: 'बहुत बढ़िया! 👍\\nआप किस शहर से हैं?',\n    next: 'category',\n    options: [\n      { id: 'lucknow', title: 'Lucknow' },\n      { id: 'kanpur', title: 'Kanpur' },\n      { id: 'varanasi', title: 'Varanasi' },\n      { id: 'agra', title: 'Agra' },\n      { id: 'prayagraj', title: 'Prayagraj' },\n      { id: 'gorakhpur', title: 'Gorakhpur' },\n      { id: 'meerut', title: 'Meerut' },\n      { id: 'noida_ghaziabad', title: 'Noida/Ghaziabad' },\n      { id: 'other_city', title: 'Other' }\n    ]\n  },\n  category: {\n    text: 'आपकी दुकान किस category में आती है?',\n    next: 'shop_status',\n    options: [\n      { id: 'sanitaryware', title: 'Sanitaryware' },\n      { id: 'bathroom_fittings', title: 'Bathroom Fittings' },\n      { id: 'hardware_plumbing', title: 'Hardware / Plumbing' },\n      { id: 'building_material', title: 'Building Material' },\n      { id: 'other_category', title: 'Other' }\n    ]\n  },\n  shop_status: {\n    text: 'क्या आपकी खुद की दुकान है?',\n    next: 'experience',\n    options: [\n      { id: 'own_shop', title: 'Own Shop' },\n      { id: 'planning_new_shop', title: 'Planning New Shop' },\n      { id: 'wholesale_distributor', title: 'Wholesale/Distributor' }\n    ]\n  },\n  experience: {\n    text: 'आपकी दुकान को कितने समय से चलाया जा रहा है?',\n    next: 'opportunity',\n    options: [\n      { id: 'exp_0_1', title: '0–1 Year' },\n      { id: 'exp_1_3', title: '1–3 Years' },\n      { id: 'exp_3_5', title: '3–5 Years' },\n      { id: 'exp_5_plus', title: '5+ Years' }\n    ]\n  },\n  opportunity: {\n    text: 'आप AGUAONE में किस तरह की business opportunity देख रहे हैं?',\n    next: 'budget',\n    options: [\n      { id: 'retail_dealership', title: 'Retail Dealership' },\n      { id: 'distributor', title: 'Distributor' },\n      { id: 'wholesale', title: 'Wholesale' },\n      { id: 'product_purchase', title: 'Product Purchase' }\n    ]\n  },\n  budget: {\n    text: 'लगभग आपका monthly sanitary/bath fitting business कितना है?',\n    next: 'handoff',\n    options: [\n      { id: 'budget_below_50k', title: '₹50K से कम' },\n      { id: 'budget_50k_2l', title: '₹50K–₹2L' },\n      { id: 'budget_2l_5l', title: '₹2L–₹5L' },\n      { id: 'budget_5l_plus', title: '₹5L+' },\n      { id: 'budget_new', title: 'अभी नया शुरू कर रहा हूँ' }\n    ]\n  }\n};\n\nconst ORDER = ['city', 'category', 'shop_status', 'experience', 'opportunity', 'budget'];\nconst RESTART_WORDS = new Set(['restart', 'restart survey', 'start over']);\n\nconst boolTrue = v => v === true || String(v).toLowerCase() === 'true';\n\nconst data = {\n  phone,\n  name,\n  city: session.city || '',\n  category: session.category || '',\n  shop_status: session.shop_status || '',\n  experience: session.experience || '',\n  opportunity: session.opportunity || '',\n  budget: session.budget || '',\n  qualified: boolTrue(session.qualified),\n  last_option: '',\n  last_message: '',\n  lead_status: session.lead_status || 'IN_PROGRESS'\n};\n\nconst stateBefore = session.state || 'new';\nlet state = stateBefore;\nlet newState = state;\nlet reply = '';\nlet replyType = 'none';\nlet options = [];\nlet action = 'NO_REPLY';\n\nfunction askQuestion(key, prefix = '') {\n  const q = QUESTIONS[key];\n  replyType = 'list';\n  reply = prefix + q.text;\n  options = q.options.map(o => ({ id: o.id, title: o.title }));\n  action = 'ASK_' + key.toUpperCase();\n}\n\n// Terminal guard: once human handoff is reached, NOTHING can restart the bot.\nif (state === 'handoff' || state === 'completed' || session.lead_status === 'HANDOFF' || boolTrue(session.qualified)) {\n  newState = 'handoff';\n  data.qualified = true;\n  data.lead_status = 'HANDOFF';\n  reply = '';\n  replyType = 'none';\n  options = [];\n  action = 'HUMAN_HANDOFF_NO_REPLY';\n\n} else if (RESTART_WORDS.has(lower)) {\n  // Restart only while the lead is still in progress.\n  data.city = '';\n  data.category = '';\n  data.shop_status = '';\n  data.experience = '';\n  data.opportunity = '';\n  data.budget = '';\n  data.qualified = false;\n  data.lead_status = 'IN_PROGRESS';\n\n  askQuestion('city');\n  newState = 'city';\n  action = 'RESTART';\n\n} else {\n  // Defensive state validation.\n  if (state !== 'new' && !ORDER.includes(state)) {\n    state = 'new';\n  }\n\n  if (state === 'new') {\n    askQuestion('city');\n    newState = 'city';\n    action = 'START';\n\n  } else {\n    const q = QUESTIONS[state];\n    let matched = null;\n\n    // Interactive reply ID is authoritative.\n    if (selectedOption) {\n      matched = q.options.find(o => o.id === selectedOption);\n    }\n\n    // Free text fallback: exact title, then safe partial match.\n    if (!matched) {\n      const candidate = (selectedTitle || rawText).toLowerCase().trim();\n      if (candidate) {\n        matched = q.options.find(o => o.title.toLowerCase() === candidate)\n          || q.options.find(o =>\n            candidate.includes(o.title.toLowerCase()) ||\n            o.title.toLowerCase().includes(candidate)\n          );\n      }\n    }\n\n    if (!matched) {\n      askQuestion(\n        state,\n        'कृपया नीचे दिए गए विकल्पों में से एक चुनें 🙏\\n\\n'\n      );\n      newState = state;\n      action = 'INVALID_RETRY';\n\n    } else {\n      data[state] = matched.title;\n      data.last_option = matched.id;\n      data.last_message = rawText || selectedTitle || matched.title;\n\n      if (state === 'budget') {\n        // Q6 complete: send acknowledgement, then permanently hand off.\n        data.qualified = true;\n        data.lead_status = 'HANDOFF';\n        newState = 'handoff';\n        replyType = 'text';\n        reply = 'धन्यवाद! 🙏\\nआपकी जानकारी हमें मिल गई है।\\nहमारी team आपसे जल्द ही संपर्क करेगी।';\n        options = [];\n        action = 'QUALIFIED_HANDOFF';\n      } else {\n        const next = q.next;\n        askQuestion(next);\n        newState = next;\n        action = 'ANSWER_ACCEPTED';\n      }\n    }\n  }\n}\n\nif (!data.last_message) {\n  data.last_message = rawText || selectedTitle || '';\n}\nif (!data.last_option) {\n  data.last_option = selectedOption || '';\n}\n\nreturn {\n  json: {\n    ...data,\n    selected_title: selectedTitle,\n    state_before: stateBefore,\n    state_after: newState,\n    reply,\n    replyType,\n    options,\n    action,\n\n    // Existing Messages sheet aliases\n    incoming_message: rawText,\n    selected_option: selectedOption,\n    bot_reply: reply,\n\n    message_id: incoming.messageId || '',\n    timestamp: incoming.timestamp || '',\n    phoneNumberId: incoming.phoneNumberId || ''\n  }\n};"
      },
